# Optional: Authorize cron endpoints (set in Vercel dashboard)
CRON_SECRET=

# Required on Vercel for durable model snapshots and watchlist updates.
# Prefer connecting a Blob store in the Vercel dashboard, which injects this.
BLOB_READ_WRITE_TOKEN=
MAX_SIGNAL_SNAPSHOT_AGE_SECONDS=1200

# Optional: Telegram daily digest
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Google Sheets logging
# Create a service account at https://console.cloud.google.com/apis/credentials
# and share your target sheet with the service account email.
GOOGLE_SHEET_PRIVATE_KEY=
GOOGLE_SHEET_CLIENT_EMAIL=
GOOGLE_SHEET_ID=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox Credentials & Safety Flags
UPSTOX_MODE=SANDBOX
LIVE_TRADING_ENABLED=false
TRADING_EXECUTION_PAUSED=true
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_SANDBOX_API_KEY=
UPSTOX_SANDBOX_API_SECRET=
UPSTOX_SANDBOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=https://unloanstockview.vercel.app/api/upstox/callback

# Options Quant: live market data + shadow/sandbox execution only
UPSTOX_ACCESS_TOKEN=
OPTIONS_QUANT_ENABLED=false
OPTIONS_QUANT_INGEST_TOKEN=
OPTIONS_QUANT_PORTFOLIO_CAPITAL=
OPTIONS_QUANT_RISK_PER_TRADE_PERCENT=1
OPTIONS_QUANT_MIN_DIRECTION_CONFIDENCE=70
OPTIONS_QUANT_MAX_DIRECTION_AGE_MINUTES=15
OPTIONS_QUANT_MIN_DTE=2
OPTIONS_QUANT_MAX_DTE=10
OPTIONS_QUANT_MIN_OI=10000
OPTIONS_QUANT_MIN_VOLUME=1000
OPTIONS_QUANT_MAX_BID_ASK_PERCENT=8
OPTIONS_QUANT_MIN_RISK_REWARD=1.2
OPTIONS_QUANT_PROFIT_TARGET_RUPEES=3000
OPTIONS_QUANT_DAILY_PROFIT_TARGET_RUPEES=3000
OPTIONS_QUANT_SLIPPAGE_BPS_PER_LEG=10
OPTIONS_QUANT_MAX_DRAWDOWN_PERCENT=8
OPTIONS_QUANT_MIN_SHADOW_TRADES=30
OPTIONS_QUANT_MIN_REAL_TRADES=50
OPTIONS_QUANT_MIN_IV_PERCENT=8
OPTIONS_QUANT_MAX_IV_PERCENT=45
OPTIONS_QUANT_MAX_IV_SKEW_PERCENT=12
OPTIONS_QUANT_MAX_THETA_DECAY_PERCENT_PER_DAY=6
OPTIONS_QUANT_MIN_PREMIUM_MOMENTUM_BPS=8
OPTIONS_QUANT_SUBMIT_SANDBOX_ORDERS=false
