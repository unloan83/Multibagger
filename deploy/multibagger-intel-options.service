[Unit]
Description=Multibagger daily market intelligence: price today's Nifty option spread from live quotes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/multibagger
EnvironmentFile=-/home/ubuntu/multibagger/.env
Environment=MB_INTEL_HOME=/home/ubuntu/multibagger-data/intel
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m intel.run options-fill
SuccessExitStatus=10
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=300M
CPUQuota=80%
Nice=10
