[Unit]
Description=Warm up Multibagger paper database from Breeze historical data
Wants=network-online.target
After=network-online.target
Conflicts=multibagger-paper.service

[Service]
Type=oneshot
User=breeze
Group=breeze
WorkingDirectory=/var/lib/multibagger
EnvironmentFile=/etc/breeze/breeze.env
EnvironmentFile=/etc/multibagger/worker.env
Environment=PYTHONPATH=/opt/multibagger
Environment=ENABLE_LIVE_TRADING=false
Environment=MARKET_DATA_PROVIDER=breeze
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/breeze/venv/bin/python -m scripts.market_engine breeze-warmup --days 3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/multibagger
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=750M
