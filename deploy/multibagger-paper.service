[Unit]
Description=Multibagger Production-Grade Paper Trading Engine
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Multibagger
Environment="PYTHONPATH=.:.python-packages"
Environment="ENABLE_LIVE_TRADING=false"
EnvironmentFile=-/home/ubuntu/Multibagger/.env.local
ExecStart=/home/ubuntu/Multibagger/.venv/bin/python engine/main.py --mode paper
Restart=on-failure
RestartSec=10s
MemoryMax=1G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
