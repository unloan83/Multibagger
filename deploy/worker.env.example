# Credentials remain in /etc/breeze/breeze.env and must not be duplicated here.
ENABLE_LIVE_TRADING=false
MARKET_DATA_PROVIDER=breeze
MARKET_DATA_DB=/var/lib/multibagger/market_data.duckdb
SIGNAL_SNAPSHOT_PATH=/var/lib/multibagger/paper_signals.json
NSE_UNIVERSE_PATH=/opt/multibagger/data/market-universe.json
# Start conservatively on VM.Standard.E2.1.Micro. Raise only after measuring memory.
NSE_UNIVERSE_SIZE=50
MAX_DATA_AGE_SECONDS=120
MIN_DAILY_VALUE_INR=50000000
MIN_RELATIVE_VOLUME=1.2
MAX_SPREAD_BPS=20
