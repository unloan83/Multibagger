# Upstox credentials remain in /etc/upstox/upstox.env and must not be duplicated here.
ENABLE_LIVE_TRADING=false
# Global fail-closed gate. Keep true until replay, shadow, sandbox lifecycle,
# persistence, scheduler, and kill-switch validation have all passed.
TRADING_EXECUTION_PAUSED=true
MARKET_DATA_PROVIDER=upstox
MARKET_DATA_DB=/var/lib/multibagger/upstox_market_data.duckdb
SIGNAL_SNAPSHOT_PATH=/var/lib/multibagger/paper_signals.json
NSE_UNIVERSE_PATH=/opt/multibagger/data/market-universe.json
# Hard-capped in code at the complete NIFTY 500 universe.
NSE_UNIVERSE_SIZE=500
MIN_PRICE_INR=150
MAX_PRICE_INR=750
MAX_DATA_AGE_SECONDS=120
MIN_DAILY_VALUE_INR=500000000
MIN_RELATIVE_VOLUME=1.5
MAX_SPREAD_BPS=8
MIN_INTRADAY_ATR_PERCENT=0.35
MAX_BREAKOUT_EXTENSION_ATR=0.60
PAPER_PORTFOLIO_CAPITAL_INR=500000
PAPER_RISK_PER_TRADE_PERCENT=0.25
PAPER_MAX_CAPITAL_PER_TRADE_PERCENT=20
PAPER_DAILY_PROFIT_TARGET_INR=3000
PAPER_DAILY_LOSS_LIMIT_INR=4000
PAPER_MAX_OPEN_POSITIONS=1
PAPER_MAX_TRADES_PER_DAY=4
PAPER_PROFIT_RISK_REDUCTION_RATIO=0.70
PAPER_PROFIT_ENTRY_LOCK_RATIO=0.90
PAPER_MAX_ENTRY_SLIPPAGE_BPS=8
PAPER_BREAK_EVEN_TRIGGER_R=0.75
PAPER_TRAILING_TRIGGER_R=1.0
PAPER_TRAILING_ATR_MULTIPLE=1.5
PAPER_MONITOR_INTERVAL_SECONDS=30
PAPER_SIGNAL_INTERVAL_SECONDS=60
PAPER_MINIMUM_HOLD_SECONDS=60
INTRADAY_TRADING_UNIVERSE_SIZE=250
ACTIVE_INTRADAY_UNIVERSE_PATH=/var/lib/multibagger/active-intraday-universe.json
NO_TRADE_EVENTS_PATH=/opt/multibagger/data/no-trade-events.json
MIN_AVERAGE_DAILY_VOLUME=500000
MIN_AVERAGE_DAILY_RANGE_PERCENT=1.5
MAX_SPREAD_BPS=8
VIX_MAX_LEVEL=20
OPTIONS_ENABLED=false
OPTIONS_QUANT_ENABLED=false
PAPER_REQUIRE_SETUP_CONFIRMATION=true
PAPER_BROKERAGE_PER_ORDER_INR=20
PAPER_FEES_BPS_PER_SIDE=5
PAPER_SLIPPAGE_BPS_PER_SIDE=5
UPSTOX_CANDLE_WATCHDOG_SECONDS=180
PAPER_JOB_LOCK_PATH=/var/lib/multibagger/paper_jobs.lock
PAPER_SUBMIT_UPSTOX_SANDBOX_ORDERS=true
# Secrets are installed separately in /etc/multibagger/telegram.env.
TELEGRAM_NOTIFICATION_STATE=/var/lib/multibagger/telegram_notification_state.json
