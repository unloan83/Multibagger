{
  "name": "multibagger",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib",
    "wealth:snapshot": "node --import tsx scripts/run_wealth_snapshot.ts",
    "term:snapshot": "node --import tsx scripts/run_term_analysis.ts",
    "longterm:snapshot": "node --import tsx scripts/run_long_term_universe.ts",
    "csv:market-close": "node scripts/update_daily_recommendations.mjs --slot market-close",
    "csv:morning": "node scripts/update_daily_recommendations.mjs --slot morning",
    "csv:afternoon": "node scripts/update_daily_recommendations.mjs --slot afternoon",
    "universe:sync": "node scripts/sync_nifty500_universe.mjs",
    "universe:sync-multibagger": "node scripts/sync_multibagger_universe.mjs",
    "engine:scan": "PYTHONPATH=.python-packages python3 -m scripts.market_engine scan",
    "engine:collect": "PYTHONPATH=.python-packages python3 -m scripts.market_engine collect",
    "engine:worker": "PYTHONPATH=.python-packages python3 -m scripts.market_engine worker",
    "engine:breeze-warmup": "PYTHONPATH=.python-packages python3 -m scripts.market_engine breeze-warmup --days 8",
    "engine:backfill": "PYTHONPATH=.python-packages python3 -m scripts.market_engine backfill --start 2022-01-01",
    "engine:backtest": "PYTHONPATH=.python-packages python3 -m scripts.market_engine backtest",
    "engine:test": "PYTHONPATH=.:.python-packages python3 -m pytest tests features/breeze/python features/upstox/python",
    "test:breeze-multibagger": "node --import tsx --test features/breeze/lib/breeze-multibagger.test.ts",
    "test:upstox-triage": "node --import tsx --test features/upstox/lib/upstox-market-triage.test.ts",
    "test:options-quant": "node --import tsx --test features/options-quant/lib/engine.test.ts",
    "options:scan": "node --import tsx scripts/run_options_quant_scan.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.19",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
